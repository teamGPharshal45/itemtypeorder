<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="AppTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:text">@string/navbar_title</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>

    <style name="ReceiptTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textSize">18dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:text">@string/receipt_title</item>
        <item name="android:layout_centerHorizontal">true</item>
    </style>


    <style name="Imagebutton" parent="Widget.AppCompat.ImageButton">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/border</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:padding">12dp</item>

    </style>

    <style name="ApplicationButton" parent="Widget.AppCompat.Button">

        <item name="android:layout_marginRight">5dp</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:layout_alignParentBottom">true</item>

        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16px</item>
        <item name="android:layout_width">match_parent</item>


    </style>



</resources>