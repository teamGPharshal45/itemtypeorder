<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.example.completeorderlistapplication.ui.checkout.tabs.customerDetailTab">



        <TextView
            android:id="@+id/nameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Kamala Khan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Buisness Name"
            android:id="@+id/businessName"
            android:layout_marginTop="2dp"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/nameField"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="contact Info"
            android:textSize="12sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/businessName"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/contactInfoHead" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            tools:text="+1 (123) 456-7890"
            app:layout_constraintTop_toBottomOf="@id/contactInfoHead"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/phoneNumberField" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:layout_marginTop="2dp"
            android:textStyle="bold"
            tools:text="msme.marvel2@gmail.com"
            app:layout_constraintTop_toBottomOf="@id/phoneNumberField"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/EmailField" />





</androidx.constraintlayout.widget.ConstraintLayout>