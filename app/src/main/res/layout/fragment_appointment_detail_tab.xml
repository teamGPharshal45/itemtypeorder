<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    tools:context="com.example.completeorderlistapplication.ui.checkout.tabs.appointmentDetailTab">




            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:id="@+id/time_logo"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/baseline_access_time_24" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Tuesday, Sep 11,2025 8:00 AM - 9:00 AM"
                    app:layout_constraintStart_toEndOf="@id/time_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    android:id="@+id/date_time"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/note"
                    android:textSize="12dp"
                    android:text="Does not repeat"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toStartOf="@id/date_time"
                    app:layout_constraintTop_toBottomOf="@id/date_time" />



            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_format_list_bulleted_24"
                android:id="@+id/menu_logo"
                app:layout_constraintTop_toBottomOf="@id/note"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Services"
                android:layout_marginStart="8dp"
                android:id="@+id/serivce_option"
                app:layout_constraintStart_toEndOf="@id/menu_logo"
                app:layout_constraintTop_toBottomOf="@id/note"
                />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/service_note"
        android:textSize="12sp"
        android:text="@string/order_title"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="@id/date_time"
        app:layout_constraintTop_toBottomOf="@id/serivce_option" />





            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/walkin_logo"
                android:src="@drawable/baseline_directions_walk_24"
                app:layout_constraintTop_toBottomOf="@id/service_note"
                app:layout_constraintStart_toStartOf="parent"
                />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Walk-In"
                android:id="@+id/walkin_menu"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@id/walkin_logo"
                app:layout_constraintTop_toBottomOf="@id/service_note"
                />





            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_money_24"
                android:id="@+id/money_logo"
                app:layout_constraintTop_toBottomOf="@id/walkin_logo"
                android:layout_marginTop="16sp"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/money_logo"
                app:layout_constraintTop_toBottomOf="@id/walkin_menu"
                app:layout_constraintBottom_toBottomOf="@id/money_logo"
                android:layout_marginTop="16sp"
                tools:text="Unpaid"
                android:layout_marginStart="8dp" />



</androidx.constraintlayout.widget.ConstraintLayout>