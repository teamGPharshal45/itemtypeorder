<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_margin="12sp"
    tools:context="com.example.completeorderlistapplication.ui.checkout.notes.CustomerNotesFragment">



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Customer Notes"
            android:id="@+id/customer_notes"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />



        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prefer Vegan products"
            android:id="@+id/NoteText"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/customer_notes"
            android:textColor="@color/black"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/DateOfNote"
            android:layout_marginEnd="64dp"
            tools:text="paul S."
            android:textSize="12sp"
            android:id="@+id/CustomerName"
            app:layout_constraintLeft_toRightOf="@id/NoteText"
            app:layout_constraintTop_toBottomOf="@id/customer_notes"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:id="@+id/DateOfNote"
            tools:text="6/12/2025"
            app:layout_constraintLeft_toRightOf="@id/CustomerName"
            app:layout_constraintTop_toBottomOf="@id/customer_notes"
            app:layout_constraintEnd_toEndOf="parent"
            android:textSize="12sp" />






</androidx.constraintlayout.widget.ConstraintLayout>